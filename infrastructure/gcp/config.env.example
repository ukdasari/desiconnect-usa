# DesiConnect on Google Cloud. Copy to config.env (git-ignored) and fill in.
#   cp infrastructure/gcp/config.env.example infrastructure/gcp/config.env

# --- project ---------------------------------------------------------------
PROJECT_ID=desiconnect-prod            # must be globally unique; created in step 1 of the runbook
REGION=us-central1                     # Cloud Run domain mapping works here; us-south1 (Dallas) also works without it
ENV_NAME=prod                          # prefix for resource names: <env>-api, <env>-web, ...

# --- database (Cloud SQL for PostgreSQL 16 + PostGIS) ----------------------
SQL_TIER=db-f1-micro                   # shared core, ~US$10/month. Use db-custom-1-3840 or larger for real traffic.
SQL_HA=false                           # true = regional high availability (doubles the database cost)

# --- public URLs -------------------------------------------------------------
# Leave empty on the first deploy: the scripts use the *.run.app URLs. Fill in after mapping your domain.
WEB_URL=
API_URL=

# --- people ------------------------------------------------------------------
# Shown on the privacy, terms and data deletion pages.
SUPPORT_EMAIL=support@desiconnect.com
# Comma-separated. These accounts become admins the first time they sign in.
BOOTSTRAP_ADMIN_EMAILS=you@example.com

# --- sign-in -------------------------------------------------------------------
# oidc  = Auth0 or another provider (recommended: email verification, password reset, Google sign-in)
# local = built-in email + password. Fine for a closed pilot; no email verification or password reset.
AUTH_MODE=local
# Only for AUTH_MODE=oidc (see docs/security/authentication.md). The client secret goes in Secret Manager, not here.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_CLIENT_ID=
OIDC_MOBILE_CLIENT_ID=

# --- social sign-in (AUTH_MODE=local) -------------------------------------------
# "Continue with Google / Facebook / X". Set up each app first: docs/security/social-sign-in.md.
# A button appears once its ID is set here AND its secret is in Secret Manager
# (google-client-secret, facebook-app-secret, x-client-secret), then re-run setup.sh and deploy.sh.
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
X_CLIENT_ID=
# With AUTH_MODE=oidc, map buttons to Auth0 connections instead, e.g. google=google-oauth2,facebook=facebook,x=twitter
OIDC_SOCIAL_CONNECTIONS=

# --- email (alerts, weekly digest, account messages) ---------------------------
# log = only written to the API log (nothing is sent). resend = send through Resend: verify your domain there,
# then store the key:  printf '%s' 're_...' | gcloud secrets create resend-api-key --data-file=-  and re-run setup.sh
EMAIL_PROVIDER=log
EMAIL_FROM="DesiConnect <updates@desiconnect.com>"
# Weekly digest schedule (Cloud Scheduler, cron syntax, America/Chicago). Default: Sundays 9:00.
DIGEST_SCHEDULE="0 9 * * 0"

# --- optional features ---------------------------------------------------------
AI_PROVIDER=none                       # anthropic = Desi AI uses Claude (needs the anthropic-api-key secret)
PUSH_PROVIDER=none                     # expo = mobile push notifications
