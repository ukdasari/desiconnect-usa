# ---------- Shared ----------
NODE_ENV=development

# ---------- Database (PostgreSQL 16 + PostGIS) ----------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/desiconnect?schema=public

# ---------- Redis (BullMQ queues, rate-limit storage) ----------
REDIS_URL=redis://localhost:6379

# ---------- API ----------
API_PORT=4000
# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# Authentication mode:
#   local -> the API issues its own signed JWTs (email + password). For development and the pilot.
#   oidc  -> tokens come from an OIDC provider (Auth0, Cognito, Entra ID, Clerk...) and are verified via JWKS.
AUTH_MODE=local
# Required when AUTH_MODE=local. Use a long random value (openssl rand -base64 48).
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_TTL_SECONDS=604800
# Required when AUTH_MODE=oidc
OIDC_ISSUER=
OIDC_AUDIENCE=

# Emails in this comma-separated list get the ADMIN role when they first sign in.
BOOTSTRAP_ADMIN_EMAILS=admin@desiconnect.example

# ---------- File storage ----------
# local -> files saved under STORAGE_LOCAL_DIR (development only)
# s3    -> any S3-compatible bucket (AWS S3, Cloudflare R2, MinIO)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------- AI assistant ----------
# none      -> built-in rule-based intent parser (no external calls)
# anthropic -> Claude, used only to parse intent; results always come from the database
AI_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
AI_DAILY_REQUEST_LIMIT=50

# ---------- Web (Next.js) ----------
# Server-side base URL the website uses to reach the API
API_URL=http://localhost:4000/api/v1
SESSION_COOKIE_SECURE=false
