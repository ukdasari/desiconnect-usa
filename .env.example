# ---------- Shared ----------
NODE_ENV=development

# ---------- Database (PostgreSQL 16 + PostGIS) ----------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/desiconnect?schema=public

# ---------- Redis (BullMQ queues, rate-limit storage) ----------
REDIS_URL=redis://localhost:6379

# ---------- API ----------
API_PORT=4000
# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# ---------- Authentication ----------
# oidc  -> sign-in through an OpenID Connect provider (Auth0, Cognito, Entra ID, Okta, Keycloak…). REQUIRED in production.
# local -> email + password handled by the API, with seeded demo accounts. Development and tests only.
# See docs/security/authentication.md for provider setup. For a provider on your laptop: pnpm oidc:dev
AUTH_MODE=local

# Used when AUTH_MODE=local (API signs its own tokens). openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_TTL_SECONDS=604800

# Used when AUTH_MODE=oidc — read by BOTH the API and the website.
OIDC_ISSUER=
# API: expected "aud" of access tokens (Auth0: the API Identifier). Website: sent as the "audience" parameter.
OIDC_AUDIENCE=
# API: client IDs whose ID tokens may be exchanged at POST /auth/session (web and mobile apps).
OIDC_CLIENT_IDS=
OIDC_REQUIRE_VERIFIED_EMAIL=true
# Website only:
OIDC_CLIENT_ID=
# Leave empty for a public client using PKCE only.
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email offline_access
# "access" (default) sends the access token to the API; use "id" for providers whose access tokens aren't JWTs for your API.
OIDC_API_TOKEN=access
# Optional authorization prompt, e.g. "consent" if your provider only issues refresh tokens with it.
OIDC_PROMPT=
# Public URL of the website (used for the callback and logout redirect).
APP_URL=http://localhost:3000
# Only for the local dev provider on http://localhost. Ignored for any non-loopback issuer.
OIDC_ALLOW_INSECURE=false

# Emails in this comma-separated list get the ADMIN role when they first sign in.
BOOTSTRAP_ADMIN_EMAILS=admin@desiconnect.example

# ---------- File storage ----------
# local -> files saved under STORAGE_LOCAL_DIR (development only)
# s3    -> any S3-compatible bucket (AWS S3, Cloudflare R2, MinIO)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------- AI assistant ----------
# none      -> built-in rule-based intent parser (no external calls)
# anthropic -> Claude, used only to parse intent; results always come from the database
AI_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
AI_DAILY_REQUEST_LIMIT=50

# ---------- Push notifications (mobile) ----------
# none -> notifications stay in the in-app inbox only
# expo -> also delivered to registered phones through the Expo push service
PUSH_PROVIDER=none
# Optional; required only if "enhanced push security" is turned on for the Expo project.
EXPO_ACCESS_TOKEN=

# ---------- Web (Next.js) ----------
# Server-side base URL the website uses to reach the API
API_URL=http://localhost:4000/api/v1
SESSION_COOKIE_SECURE=false
