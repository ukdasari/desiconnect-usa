# Phones and emulators can't reach "localhost" — use your computer's LAN IP (Android emulator: 10.0.2.2).
EXPO_PUBLIC_API_URL=http://192.168.1.20:4000/api/v1
# Used only when the API runs with AUTH_MODE=oidc. Register it with your provider as a native/public client
# (PKCE, no secret) with redirect URI onestopdesi://auth/callback, and add it to the API's OIDC_CLIENT_IDS.
EXPO_PUBLIC_OIDC_CLIENT_ID=desiconnect-mobile
# Website used for "Terms", "Privacy" and the share links.
EXPO_PUBLIC_WEBSITE_URL=http://localhost:3000
