{
  "expo": {
    "name": "DesiConnect",
    "slug": "desiconnect-usa",
    "scheme": "desiconnect",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.desiconnect.usa",
      "supportsTablet": true
    },
    "android": {
      "package": "com.desiconnect.usa"
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": false
    }
  }
}
