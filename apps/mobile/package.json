{
  "name": "@desiconnect/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "jest",
    "export:web": "expo export --platform web --output-dir dist-web"
  },
  "dependencies": {
    "@desiconnect/contracts": "workspace:*",
    "@desiconnect/ui": "workspace:*",
    "@expo/vector-icons": "^15.0.2",
    "expo": "~58.0.22",
    "expo-constants": "~58.0.14",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.29",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "expo-auth-session": "~58.0.16",
    "expo-web-browser": "~58.0.7",
    "expo-crypto": "~58.0.7",
    "expo-location": "~58.0.20",
    "expo-notifications": "~58.1.7",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "@react-native-async-storage/async-storage": "2.2.0",
    "react-native-web": "~0.21.4",
    "react-dom": "19.3.0",
    "@expo/metro-runtime": "~58.0.16"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "typescript": "~5.9.3",
    "jest-expo": "~58.0.13",
    "jest": "^29.7.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.14"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|@desiconnect/.*)"
    ],
    "setupFiles": [
      "./jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  }
}
