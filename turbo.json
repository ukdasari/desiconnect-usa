{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": ["NODE_ENV", "DATABASE_URL", "API_URL", "EXPO_PUBLIC_API_URL"],
  "globalPassThroughEnv": [
    "TEST_DATABASE_URL",
    "REDIS_URL",
    "JWT_SECRET",
    "AUTH_MODE",
    "CI",
    "PRISMA_*",
    "PLAYWRIGHT_BROWSERS_PATH",
    "HOME",
    "PATH"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
