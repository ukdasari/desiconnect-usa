{
  "name": "@desiconnect/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Shared design tokens (colors, type, spacing, radius) for web and mobile",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./tokens.css"
  },
  "files": ["dist", "tokens.css"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@desiconnect/config": "workspace:*",
    "@types/node": "^22.18.0",
    "eslint": "^9.39.0",
    "typescript": "~5.9.3"
  }
}
